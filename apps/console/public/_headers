# Security + caching headers for the authenticated console SPA.
# Mirrors apps/web/public/_headers, with two differences: the console opens a
# WebSocket to the platform agent, and it must never be indexed.

# Cache-Control lives ONLY here, never in the `/*` block below: every matching
# rule is applied and the values are concatenated, so a `Cache-Control` on `/*`
# reached these files as `no-cache, public, max-age=31536000, immutable`, and
# `no-cache` wins — revalidating every hashed asset on every load. The shell's
# `no-cache` is set by the Worker instead.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell, requested by its own path. Deep SPA routes (/dashboard, …) match no
# asset, so they reach the Worker and get `no-cache` there — but `/` and
# `/index.html` ARE assets, served without waking the Worker, so their rule has
# to live here. Both rules are exact paths and cannot collide with /assets/*.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # connect-src additionally allows wss: for the platform agent (Agents SDK)
  # WebSocket, which is proxied same-origin through this Worker.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; font-src 'self'; connect-src 'self' wss://console.skillist.io https://api.skillist.io https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
