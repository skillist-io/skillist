{
  "name": "skillist-api-production",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serve ONLY on the routes below. Left enabled, the default
  // skillist-api-production.<subdomain>.workers.dev hostname exposes the whole
  // API — auth, /v1, /mcp, apex execution — while bypassing the skillist.io
  // zone, and with it the WAF, zone rate-limiting rules, and bot protection.
  "workers_dev": false,
  "preview_urls": false,
  // Run the Worker near the database so multi-query requests don't pay a
  // client<->origin round-trip per query.
  "placement": { "mode": "smart" },
  // Workers Caching sits IN FRONT of the Worker: a hit is served without
  // running it. That is what makes the delivery Cache-Control headers real —
  // a Worker's own responses are not otherwise cached by Cloudflare, and the
  // per-colo Cache API in routes/delivery.ts could only ever be consulted
  // AFTER the request had already travelled to the Smart Placement location
  // beside the database. Measured: a pinned-version read that hit the Cache
  // API still cost ~120ms of server time versus ~50ms for an edge-served
  // asset, because the hit was in the placement colo, not the reader's.
  //
  // Caching is opt-in per response: a global middleware in src/index.ts marks
  // anything without an explicit Cache-Control as `no-store`, so only the
  // delivery routes are eligible. Note this also bills requests that are
  // otherwise free — static assets (none here) and service-binding calls from
  // the web/console Workers.
  "cache": { "enabled": true },
  "vars": {
    "BETTER_AUTH_URL": "https://api.skillist.io",
    "WEB_URL": "https://skillist.io"
  },
  "routes": [
    { "pattern": "api.skillist.io", "custom_domain": true },
    { "pattern": "skillist.io/api/*", "zone_name": "skillist.io" },
    { "pattern": "skillist.io/v1/*", "zone_name": "skillist.io" }
  ],
  "triggers": {
    // Daily 06:00 UTC sync; weekly Sunday 07:00 UTC discover (CF: 1=Sun…7=Sat, not 0=Sun)
    "crons": ["0 6 * * *", "0 7 * * sun", "0 */6 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Without this the bundled output is minified, so the stack in a Workers Logs
  // trace points at unreadable positions. onError already logs a cf-ray
  // correlation id; this is what makes that id actionable.
  "upload_source_maps": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3864600443334cd68ad86d592df9fd4a"
    },
    {
      // Caching-DISABLED config over the same DB. Default client for auth /
      // permissions / writes, so a revoked key stops authenticating immediately.
      "binding": "HYPERDRIVE_CACHE_DISABLED",
      "id": "1f35001220914a8b986b7fddb4523c9d"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SKILLS_KV",
      "id": "e3efe45d7f14430ab6c5868235e6755f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SKILLS_R2",
      "bucket_name": "skillist-skills"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // Unauthenticated + expensive: magic-link/OTP mail sends, OAuth callbacks,
      // passkey attempts, MCP session creation. A namespace's own limit is what
      // actually governs, so tightening these required a separate namespace
      // rather than a smaller argument at the call site.
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      // Session reads (`get-session`, `list-sessions`, `list-accounts`,
      // `list-user-passkeys`). Authenticated and usually served from the 60s
      // cookie cache without touching Postgres, but the console calls
      // `get-session` on every route `beforeLoad` and every hover-preload — and
      // the key is per-IP, so a NAT'd office shares one bucket. Under the 20/60s
      // AUTH namespace that 429'd, and the client rendered the 429 as
      // "We couldn't verify your session", signing people out mid-session.
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SKILL_HUB",
        "class_name": "SkillRealtimeHub"
      },
      {
        "name": "SANDBOX",
        "class_name": "Sandbox"
      },
      {
        "name": "SANDBOX_HEAVY",
        "class_name": "SandboxHeavy"
      },
      {
        // Kebab-cases to the `skillist-agent` routing namespace (see
        // routeAgentRequest in src/index.ts). class_name points at the DO.
        "name": "SKILLIST_AGENT",
        "class_name": "SkillistAgent"
      }
    ]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 50
    },
    {
      "class_name": "SandboxHeavy",
      "image": "./Dockerfile.heavy",
      "instance_type": "standard-1",
      "max_instances": 20
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SkillRealtimeHub"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SandboxHeavy"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["SkillistAgent"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Shared by failure-mining (kind:"failure", skillId) and docs-RAG (kind:"doc",
  // seeded by `pnpm embed:docs`) vectors. Metadata FILTERS enforce both the
  // doc/failure split and per-skill/per-tenant scoping — and Vectorize only
  // enforces a filter when a metadata index exists for that property. BOTH are
  // REQUIRED (without `skillId`, a failure query isn't tenant-scoped). Provision
  // with `bash scripts/provision-vectorize.sh` before any vectors are written:
  //   wrangler vectorize create skillist-failures --dimensions=768 --metric=cosine
  //   wrangler vectorize create-metadata-index skillist-failures --property-name=kind --type=string
  //   wrangler vectorize create-metadata-index skillist-failures --property-name=skillId --type=string
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "skillist-failures"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_QUEUE",
        "queue": "skillist-ai-jobs"
      },
      {
        "binding": "SYNC_QUEUE",
        "queue": "skillist-sync-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "skillist-ai-jobs",
        "max_batch_size": 1,
        "max_retries": 3,
        // Unset, max_concurrency scales to the platform maximum: a backlog then
        // fans out arbitrarily many consumers, each opening a Hyperdrive→Neon
        // connection AND calling the AI provider. Bounded so a burst cannot
        // exhaust the connection pool and the AI budget at the same time.
        "max_concurrency": 3,
        // Without a delay, message.retry() re-delivers immediately, so a poison
        // AI job burns all 3 retries within seconds.
        "retry_delay": 60,
        // Capture poison messages instead of dropping them after retries.
        "dead_letter_queue": "skillist-ai-jobs-dlq"
      },
      {
        // Drained by handleDeadLetterBatch: logs each message and writes an
        // audit row, then acks. Declared but unconsumed, these silently
        // accumulated poison messages nobody would ever see.
        "queue": "skillist-ai-jobs-dlq",
        "max_batch_size": 10,
        "max_retries": 1
      },
      {
        "queue": "skillist-sync-jobs-dlq",
        "max_batch_size": 10,
        "max_retries": 1
      },
      {
        "queue": "skillist-sync-jobs",
        "max_batch_size": 5,
        "max_retries": 5,
        "max_concurrency": 5,
        "retry_delay": 120,
        "dead_letter_queue": "skillist-sync-jobs-dlq"
      }
    ]
  },
  "workflows": [
    {
      "binding": "SYNC_WORKFLOW",
      "name": "sync-source-workflow",
      "class_name": "SyncSourceWorkflow"
    },
    {
      "binding": "FAILURE_WORKFLOW",
      "name": "failure-mining-workflow",
      "class_name": "FailureMiningWorkflow"
    }
  ]
}
