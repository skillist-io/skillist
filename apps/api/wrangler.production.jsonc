{
  "name": "skillist-api-production",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  // Run the Worker near the database so multi-query requests don't pay a
  // client<->origin round-trip per query.
  "placement": { "mode": "smart" },
  "vars": {
    "BETTER_AUTH_URL": "https://api.skillist.io",
    "WEB_URL": "https://skillist.io"
  },
  "routes": [
    { "pattern": "api.skillist.io", "custom_domain": true },
    { "pattern": "skillist.io/api/*", "zone_name": "skillist.io" },
    { "pattern": "skillist.io/v1/*", "zone_name": "skillist.io" }
  ],
  "triggers": {
    // Daily 06:00 UTC sync; weekly Sunday 07:00 UTC discover (CF: 1=Sun…7=Sat, not 0=Sun)
    "crons": ["0 6 * * *", "0 7 * * sun"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3864600443334cd68ad86d592df9fd4a"
    },
    {
      // Caching-DISABLED config over the same DB. Default client for auth /
      // permissions / writes, so a revoked key stops authenticating immediately.
      "binding": "HYPERDRIVE_CACHE_DISABLED",
      "id": "1f35001220914a8b986b7fddb4523c9d"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SKILLS_KV",
      "id": "e3efe45d7f14430ab6c5868235e6755f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SKILLS_R2",
      "bucket_name": "skillist-skills"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SKILL_HUB",
        "class_name": "SkillRealtimeHub"
      },
      {
        "name": "SANDBOX",
        "class_name": "Sandbox"
      },
      {
        "name": "SANDBOX_HEAVY",
        "class_name": "SandboxHeavy"
      }
    ]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 50
    },
    {
      "class_name": "SandboxHeavy",
      "image": "./Dockerfile.heavy",
      "instance_type": "standard-1",
      "max_instances": 20
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SkillRealtimeHub"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SandboxHeavy"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_QUEUE",
        "queue": "skillist-ai-jobs"
      },
      {
        "binding": "SYNC_QUEUE",
        "queue": "skillist-sync-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "skillist-ai-jobs",
        "max_batch_size": 1,
        "max_retries": 3,
        // Capture poison messages instead of dropping them after retries.
        "dead_letter_queue": "skillist-ai-jobs-dlq"
      },
      {
        "queue": "skillist-sync-jobs",
        "max_batch_size": 5,
        "max_retries": 5,
        "dead_letter_queue": "skillist-sync-jobs-dlq"
      }
    ]
  },
  "workflows": [
    {
      "binding": "SYNC_WORKFLOW",
      "name": "sync-source-workflow",
      "class_name": "SyncSourceWorkflow"
    }
  ]
}
