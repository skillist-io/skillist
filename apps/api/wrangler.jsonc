{
  "name": "skillist-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787"
  },
  "dev": {
    "port": 8787
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local-hyperdrive",
      "localConnectionString": "postgresql://user:pass@host/neondb?sslmode=require"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SKILLS_KV",
      "id": "local-skills-kv",
      "preview_id": "local-skills-kv"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SKILLS_R2",
      "bucket_name": "skillist-skills",
      "preview_bucket_name": "skillist-skills-preview"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SKILL_HUB",
        "class_name": "SkillRealtimeHub"
      },
      {
        "name": "SANDBOX",
        "class_name": "Sandbox"
      },
      {
        "name": "SANDBOX_HEAVY",
        "class_name": "SandboxHeavy"
      }
    ]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 10
    },
    {
      "class_name": "SandboxHeavy",
      "image": "./Dockerfile.heavy",
      "instance_type": "basic",
      "max_instances": 5
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SkillRealtimeHub"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SandboxHeavy"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_QUEUE",
        "queue": "skillist-ai-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "skillist-ai-jobs",
        "max_batch_size": 1,
        "max_retries": 3
      }
    ]
  }
}
