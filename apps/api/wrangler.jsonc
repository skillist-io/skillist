{
  "name": "skillist-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "WEB_URL": "http://localhost:5173"
  },
  "dev": {
    "port": 8787
  },
  "triggers": {
    // Daily 06:00 UTC sync; weekly Sunday 07:00 UTC discover (CF: 1=Sun…7=Sat, not 0=Sun)
    "crons": ["0 6 * * *", "0 7 * * sun"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local-hyperdrive",
      "localConnectionString": "postgresql://user:pass@host/neondb?sslmode=require"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SKILLS_KV",
      "id": "local-skills-kv",
      "preview_id": "local-skills-kv"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SKILLS_R2",
      "bucket_name": "skillist-skills",
      "preview_bucket_name": "skillist-skills-preview"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SKILL_HUB",
        "class_name": "SkillRealtimeHub"
      },
      {
        "name": "SANDBOX",
        "class_name": "Sandbox"
      },
      {
        "name": "SANDBOX_HEAVY",
        "class_name": "SandboxHeavy"
      }
    ]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 10
    },
    {
      "class_name": "SandboxHeavy",
      "image": "./Dockerfile.heavy",
      "instance_type": "basic",
      "max_instances": 5
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SkillRealtimeHub"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SandboxHeavy"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_QUEUE",
        "queue": "skillist-ai-jobs"
      },
      {
        "binding": "SYNC_QUEUE",
        "queue": "skillist-sync-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "skillist-ai-jobs",
        "max_batch_size": 1,
        "max_retries": 3
      },
      {
        "queue": "skillist-sync-jobs",
        "max_batch_size": 5,
        "max_retries": 5
      }
    ]
  },
  "workflows": [
    {
      "binding": "SYNC_WORKFLOW",
      "name": "sync-source-workflow",
      "class_name": "SyncSourceWorkflow"
    }
  ]
}
