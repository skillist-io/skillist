{
  "name": "skillist-web",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-15",
  // Serve only on the custom domain below — the *.workers.dev hostname would
  // otherwise serve this app (and proxy the API through it) outside the zone.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "API",
      "service": "skillist-api-production"
    }
  ],
  "routes": [{ "pattern": "skillist.io", "custom_domain": true }]
}
