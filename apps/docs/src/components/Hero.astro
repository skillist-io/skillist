---
import DraftContentNotice from "virtual:starlight/components/DraftContentNotice";
import { HeroActions } from "./docs/HeroActions";

const PAGE_TITLE_ID = "_top";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero">
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
      {data.draft && <DraftContentNotice />}
      {tagline && <p class="tagline">{tagline}</p>}
    </div>
    {
      actions.length > 0 && (
        <HeroActions
          client:load
          actions={actions.map((action) => ({
            text: action.text,
            link: action.link,
            variant: action.variant,
            icon: action.icon?.name,
          }))}
        />
      )
    }
  </div>
</div>

<style>
  @layer starlight.core {
    .hero {
      display: grid;
      align-items: center;
      padding-block: clamp(2.5rem, calc(1rem + 8vmin), 6rem);
      padding-bottom: 1rem;
    }

    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
      text-align: center;
      max-width: 48rem;
      margin-inline: auto;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .copy > * {
      max-width: 50ch;
    }

    h1 {
      font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
      line-height: 1.1;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--foreground);
    }

    .tagline {
      font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-lg));
      color: var(--muted-foreground);
      line-height: 1.6;
      margin: 0;
      max-width: 42ch;
    }

    @media (min-width: 50rem) {
      .stack {
        text-align: start;
        margin-inline: 0;
      }

      .copy {
        align-items: flex-start;
      }
    }
  }
</style>
