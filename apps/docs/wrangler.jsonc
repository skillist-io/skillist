{
  "name": "skillist-docs",
  "compatibility_date": "2026-07-01",
  // Serve only on docs.skillist.dev — a *.workers.dev copy of the docs would be
  // separately indexable and duplicate the canonical site.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    // Pure static site with no Worker script: serve Starlight's own 404 page
    // rather than the bare platform 404.
    "not_found_handling": "404-page"
  },
  // docs.skillist.io stays attached only so the host keeps resolving: the zone's
  // redirect rule (scripts/setup-legacy-redirect.sh) 301s it to skillist.dev at
  // the edge, before the assets are served.
  "routes": [
    { "pattern": "docs.skillist.dev", "custom_domain": true },
    { "pattern": "docs.skillist.io", "custom_domain": true }
  ]
}
