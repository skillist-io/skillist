{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".wrangler/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      // Turborepo runs tasks in a filtered environment. Without this,
      // TEST_DATABASE_URL never reaches vitest, every `describe.skipIf(!hasTestDb)`
      // suite silently skips, and the run still goes green — including in CI,
      // where the postgres service container was doing nothing for the test job.
      "env": ["TEST_DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
