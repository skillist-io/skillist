{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".wrangler/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      // CI is declared so it lands in the task hash: the latency budgets in
      // publish-latency.test.ts differ between CI and local, so without it turbo
      // would replay a strict-budget local result into a CI run, or the reverse.
      "env": ["CI"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
