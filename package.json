{
  "name": "skillist",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@skillist/api",
    "dev:web": "turbo dev --filter=@skillist/web",
    "dev:console": "turbo dev --filter=@skillist/console",
    "dev:docs": "turbo dev --filter=@skillist/docs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "turbo test",
    "db:generate": "pnpm --filter @skillist/db generate",
    "db:migrate": "pnpm --filter @skillist/db migrate",
    "db:up": "docker compose up -d --wait neon-local",
    "db:down": "docker compose down",
    "db:migrate:local": "pnpm --filter @skillist/db migrate",
    "typecheck": "turbo typecheck",
    "smoke": "pnpm cli:build && vitest run --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "setup:local": "bash scripts/setup-local.sh",
    "setup:oauth": "bash scripts/setup-oauth.sh",
    "setup:secrets": "bash scripts/setup-production-secrets.sh",
    "mirror-sync:provision": "bash scripts/provision-mirror-sync-infra.sh",
    "mirror-sync:post-merge": "bash scripts/mirror-sync-post-merge.sh",
    "seed:registry": "tsx scripts/seed-registry.ts",
    "run:public-evals": "tsx scripts/run-public-evals.ts",
    "embed:docs": "tsx apps/api/scripts/embed-docs.ts",
    "cli": "pnpm --filter @skillist/cli dev",
    "cli:build": "pnpm --filter @skillist/skill-format build && pnpm --filter @skillist/cli build",
    "publish:packages": "pnpm --filter @skillist/skill-format publish --no-git-checks && pnpm --filter @skillist/cli publish --no-git-checks",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "^1.55.0",
    "@skillist/db": "workspace:*",
    "@skillist/skill-format": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "lefthook": "2.1.10",
    "tsx": "^4.20.3",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=20"
  }
}
