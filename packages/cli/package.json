{
  "name": "@skillist/cli",
  "version": "0.5.1",
  "description": "CLI for the Skillist Agent Skills platform",
  "license": "MIT",
  "type": "module",
  "bin": {
    "skillist": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "agents",
    "skills",
    "agentskills",
    "cli",
    "skillist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/skillist-io/skillist.git",
    "directory": "packages/cli"
  },
  "homepage": "https://skillist.dev",
  "bugs": {
    "url": "https://github.com/skillist-io/skillist/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@skillist/skill-format": "workspace:*"
  },
  "devDependencies": {
    "@skillist/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
