{
  "name": "@skillist/skill-format",
  "version": "0.2.0",
  "description": "agentskills.io bundle validation and review for Skillist",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blakebauman/skillist.git",
    "directory": "packages/skill-format"
  },
  "homepage": "https://skillist.dev",
  "keywords": [
    "agents",
    "skills",
    "agentskills",
    "skillist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@skillist/tsconfig": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
