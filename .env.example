# Neon (migrations + drizzle; runtime reaches it via Hyperdrive)
# Project: lively-dew-31540211 (skillist)
#
# Local dev uses Neon Local (docker compose): `pnpm db:up` proxies an ephemeral
# branch at localhost:5432. Point DATABASE_URL at it, then `pnpm db:migrate:local`:
DATABASE_URL=postgresql://neon:npg@localhost:5432/neondb?sslmode=require
# (Or point DATABASE_URL at a Neon cloud branch directly to skip Neon Local.)

# Neon Local (docker compose) — spawns/deletes ephemeral branches. Get an API
# key at https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=
NEON_PROJECT_ID=lively-dew-31540211
# Clean, empty parent branch that ephemeral local branches fork from.
NEON_PARENT_BRANCH_ID=br-damp-sun-ad62bhoy

# Better Auth — baseURL must match where /api/auth/* is served
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8787

# GitHub OAuth — https://better-auth.com/docs/authentication/github
# Redirect URI: http://localhost:8787/api/auth/callback/github
# Production:    https://api.skillist.io/api/auth/callback/github
# GitHub Apps: enable Email Addresses → Read-only permission
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — https://better-auth.com/docs/authentication/google
# Redirect URI: http://localhost:8787/api/auth/callback/google
# Production:    https://api.skillist.io/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Gateway
AI_GATEWAY_ACCOUNT_ID=
AI_GATEWAY_TOKEN=

# Web — must point at API origin (where Better Auth handler lives)
VITE_API_URL=http://localhost:8787
